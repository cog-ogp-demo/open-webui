# === Database ===
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gogovsg

# === Redis ===
REDIS_OTP_URI=redis://localhost:6379/0
REDIS_SESSION_URI=redis://localhost:6379/1
REDIS_REDIRECT_URI=redis://localhost:6379/2
REDIS_STAT_URI=redis://localhost:6379/3
REDIS_SAFE_BROWSING_URI=redis://localhost:6379/4

# === NextAuth ===
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-secret

# === App Config ===
NODE_ENV=development
OG_URL=https://go.gov.sg
ASSET_VARIANT=gov
VALID_EMAIL_GLOB_EXPRESSION=*.gov.sg
SESSION_SECRET=change-this

# === AWS / S3 ===
AWS_S3_BUCKET=local-bucket
AWS_ACCESS_KEY_ID=foobar
AWS_SECRET_ACCESS_KEY=foobar
AWS_REGION=ap-southeast-1
S3_ENDPOINT=http://localhost:4566

# === Email (Maildev for dev) ===
SES_HOST=localhost
SES_PORT=1025

# === Optional ===
GA_TRACKING_ID=
LOGIN_MESSAGE=Your OTP might take a while to arrive.
USER_MESSAGE=
ANNOUNCEMENT_MESSAGE=
ANNOUNCEMENT_TITLE=
ANNOUNCEMENT_SUBTITLE=
